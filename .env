# ==================================================
# 🌍 GLOBAL ENVIRONMENT SETTINGS
# ==================================================
PROJECT_NAME=algotrading_v10
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHONPATH=/app

# ==================================================
# 💾 DATABASE CONFIG
# ==================================================
DATABASE_URL=postgresql://trader:traderpass@timescaledb:5432/trading
# ^ Must match docker-compose service name (`timescaledb`), not `postgres`

# ==================================================
# 📊 MONITORING SERVICE CONFIG
# ==================================================
SERVICE_NAME=monitoring_service
LOG_DIR=/logs
MONITOR_PORT=8070
MONITOR_HEALTH_INTERVAL=30

# ==================================================
# ⚙️ PROMETHEUS / ALERTMANAGER / LOKI SETTINGS
# ==================================================
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100

# ==================================================
# 🧠 DATA SERVICE CONFIG
# ==================================================
DATA_SERVICE_PORT=8080

# Kafka + MinIO connections for ingestion
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=marketdata
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioaccess
MINIO_SECRET_KEY=miniopass
MINIO_BUCKET=market-data

# ==================================================
# 💹 ZERODHA KITE CONFIG (managed by auth_service)
# ==================================================

# Zerodha Kite credentials
KITE_API_KEY=gouftxcthlwelj97
KITE_API_SECRET=qkkufjyjbjy3dq0r1c36iwqt03sce0ca

# These will be filled automatically
KITE_REQUEST_TOKEN=zEl0FjAWF2F9pS1X96AH6ZMiw0xfrDCs
KITE_ACCESS_TOKEN=RC6pOWoJMoDDbiu37JZjt7E3b43gii6u
KITE_REFRESH_TOKEN=

# Internal services
INGESTION_API=http://data_service:8080/api/v1/reload
ALLOWED_ORIGINS=http://localhost:3000

# Optional watcher
ENABLE_WATCHER=true


# --- Instrument tokens for NIFTY / BANKNIFTY / etc ---
KITE_TOKENS=[256265,260105]

# --- Optional service callback URL ---


# Local debug toggles
# Enable low-level Kite WebSocket debug tracing (set 1 to enable locally)
KITE_WS_DEBUG=1
