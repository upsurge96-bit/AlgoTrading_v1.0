# Kite API Credentials
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_api_secret

# Security settings
# Generate a strong random key for token encryption
TOKEN_ENCRYPTION_KEY=change_this_to_a_random_secure_string_for_production
# API key for accessing admin endpoints
ADMIN_API_KEY=change_me_in_production

# Kafka Configuration
# Control whether events are published to Kafka
ENABLE_KAFKA=true
# Comma-separated list of Kafka brokers
KAFKA_BROKERS=kafka:9092
# Client implementation to use: 'confluent' (high performance) or 'kafka-python' (pure Python)
KAFKA_CLIENT=confluent